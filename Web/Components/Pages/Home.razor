@page "/"
@rendermode InteractiveServer
@using Core.Entities
@using Core.Interfaces
@using Web.Services
@inject IEventRepository EventRepository
@implements IDisposable
@inject LiveSyncService SyncService

<PageTitle>Interrogo - Home</PageTitle>

<h1>My Events</h1>

<div class="mb-3">
    <input type="text" class="form-control" placeholder="Event Name (C# Workshop)" @bind="_newEventTitle">
    <button class="btn btn-primary" @onclick="CreateEventAsync">
        + Create a new event
    </button>
</div>

@if (_events == null)
{
    <p><em>Loading...</em></p>
}
else if (!_events.Any())
{
    <p>Wow no events. Such empty!</p>
}
else
{
    <table>
        <thead>
        <tr>
            <th>Event code</th>
            <th>Title</th>
            <th>Created on</th>
        </tr>
        </thead>
        <tbody>
            @foreach (var evt in _events)
            {
                <tr>
                    <td><strong>@evt.EventCode</strong></td>
                    <td>@evt.Title</td>
                    <td>@evt.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td>
                        <a href="/event/@evt.Id" class="btn btn-sm btn-primary">Open</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IEnumerable<Event>? _events;
    private string? _newEventTitle = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadEventsAsync();
        SyncService.OnNewEventCreated += HandleNewEventCreated;
    }

    private async void HandleNewEventCreated()
    {
        await LoadEventsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadEventsAsync()
    {
        _events = await EventRepository.GetAllAsync();
    }

    private async Task CreateEventAsync()
    {
        if (string.IsNullOrWhiteSpace(_newEventTitle))
            return;

        var randomCode = $"INTERR-{Random.Shared.Next(1000, 9999)}";
        var newEvent = new Event
        {
            EventCode = randomCode,
            Title = _newEventTitle,
        };
        
        
        await EventRepository.CreateAsync(newEvent);
        
        _newEventTitle = string.Empty;
        
        await LoadEventsAsync();
        SyncService.NotifyNewEventCreated();
    }

    private async Task CreateDummyEvent()
    {
        var randomCode = $"NSQL-{Random.Shared.Next(1000, 9999)}";

        var newEvent = new Event
        {
            EventCode = randomCode,
            Title = "Testovací přednáška NoSQL",
        };
        
        await EventRepository.CreateAsync(newEvent);
        
        await LoadEventsAsync();
    }

    public void Dispose()
    {
        SyncService.OnNewEventCreated -= HandleNewEventCreated;
    }

}